MONGO_URI=
JWT_SECRET=

# Email Configuration (recommended: Resend HTTPS API)
RESEND_API_KEY=
RESEND_FROM=verified-sender@yourdomain.com

# SMTP fallback (use only when RESEND_API_KEY is not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_SECURE=false

# WhatsApp Business API scheduled report delivery
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REPORT_TEMPLATE_NAME=business_report
WHATSAPP_REPORT_TEMPLATE_LANGUAGE=en
# Approved template body: Hello {{1}}, your {{2}} report for {{3}} is ready ({{4}}).
# Revenue: {{5}}. Expenses: {{6}}. Profit: {{7}}.
WHATSAPP_MESSAGE_TEMPLATE_NAME=admin_communication
WHATSAPP_MESSAGE_TEMPLATE_LANGUAGE=en
# Approved template body: Hello {{1}}, a message about {{2}}: {{3}}.

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173
